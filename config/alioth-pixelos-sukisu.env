# PixelOS alioth (Redmi K40 / POCO F3) + KernelSU-Next (legacy-susfs) + SUSFS v1.5.5
# 內核: 4.19.325 非 GKI  |  ROM: PixelOS sixteen-qpr2 (16.2)
CONFIG_ENV=config/alioth-pixelos-sukisu.env

# ===== 內核源碼 =====
# ↓↓↓ 改成你 fork 的位址 ↓↓↓
KERNEL_SOURCE=https://github.com/W-Nana/android_kernel_xiaomi_sm8250
KERNEL_SOURCE_BRANCH=sixteen-qpr2
KERNEL_CONFIG=vendor/alioth_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 留空！保持 CONFIG_LOCALVERSION="-perf" 與原版 PixelOS 完全一致，
# uname 不會出現自訂字樣 —— 這對隱藏 root 很重要。
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ===== 工具鏈：4.19 必須用舊 clang =====
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ===== SukiSU =====
# SukiSU builtin 需要 SUSFS v2.x API，但 4.19 只有 v1.5.5，無解。
# v3.1.0-legacy-susfs 的 Kconfig 正是 v1.5.5 符號家族。
KSU_VARIANT=kernelsu-next
KSU_REF=v3.1.0-legacy-susfs
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ===== 隱藏相關（你的核心需求）=====
ENABLE_SUSFS=true
SUSFS_REPO=https://github.com/W-Nana/KernelSU_Action.git
SUSFS_BRANCH=kernel-4.19
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ===== Kconfig =====
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ===== 打包 =====
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
